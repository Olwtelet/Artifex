---
import { playlists } from '../data/playlists'
import type { Locale } from '../config/site'
import { useTranslations } from '../i18n/translations'

interface Props {
  locale: Locale
}

const { locale }: Props = Astro.props
const t = useTranslations(locale)

// Playlist descriptions are creative Portuguese texts by design;
// mark them for assistive tech when the page language is English.
const descriptionLang = locale === 'en' ? 'pt-BR' : undefined
---

<ul class="playlist-list">
  {
    playlists.map((playlist) => (
      <li>
        <a
          class="big-text playlist-link"
          href={playlist.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {playlist.name}
        </a>
        <div
          class="playlist-img"
          style={`--image:url(${playlist.image})`}
          aria-hidden="true"
        />
        <br />
        <small lang={descriptionLang}>{playlist.description}</small>
      </li>
    ))
  }
</ul>

<p class="big-text">{t.playlists.outro}</p>

<style>
  .playlist-list {
    margin-bottom: 2rem;

    & li {
      margin-bottom: 1.4rem;
    }
  }

  .playlist-img {
    opacity: 0.3;
    visibility: hidden;

    &,
    &::before {
      background-size: cover;
      background-position: center;
      position: fixed;
      z-index: -1;
      top: 0;
      left: 0;
      bottom: 0;
      right: 0;
    }

    &::before {
      content: '';
      background-image: url(/assets/images/effect-static.gif);
      transition: opacity 0.4s;

      html.webp & {
        background-image: url(/assets/images/effect-static.webp);
      }
    }

    .playlist-link:is(:hover, :focus) + & {
      visibility: visible;
      background-image: var(--image);

      &::before {
        opacity: 0.2;
      }
    }
  }
</style>
