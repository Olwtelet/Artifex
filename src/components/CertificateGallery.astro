---
import { certificateGroups } from '../data/certificates'
import type { Locale } from '../config/site'
import { LOCALE_CODES } from '../config/site'

interface Props {
  locale: Locale
}

const { locale }: Props = Astro.props
const pageLang = LOCALE_CODES[locale]

// Short month without the abbreviation dot ("set", "Sep"); CSS uppercases it.
const monthFormat = new Intl.DateTimeFormat(pageLang, {
  month: 'short',
  timeZone: 'UTC',
})

function issuedLabel(isoDate: string): string {
  const date = new Date(`${isoDate}T00:00:00Z`)
  return `${monthFormat.format(date).replace('.', '')} ${date.getUTCFullYear()}`
}
---

{
  certificateGroups.map((group) => (
    <section class="certificate-group">
      <h2 class="index-subtitle">{group.label}</h2>
      <ul class="certificate-gallery">
        {group.certificates.map((certificate) => {
          const image = `/assets/images/.certificates/${certificate.slug}`
          return (
            <li>
              <a
                class="certificate-card"
                href={certificate.verifyUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                <picture class="certificate-card__thumb">
                  <source srcset={`${image}.webp`} type="image/webp" />
                  <img
                    src={`${image}.jpg`}
                    alt=""
                    width={group.thumbnail.width}
                    height={group.thumbnail.height}
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
                <span
                  class="certificate-card__name"
                  lang={
                    certificate.lang === pageLang ? undefined : certificate.lang
                  }
                >
                  {certificate.name}
                </span>
                <time
                  class="certificate-card__date"
                  datetime={certificate.issued}
                >
                  {issuedLabel(certificate.issued)}
                </time>
              </a>
              <div
                class="certificate-backdrop"
                style={`--image:url(${image}.jpg)`}
                aria-hidden="true"
              />
            </li>
          )
        })}
      </ul>
    </section>
  ))
}

<style>
  .certificate-group + .certificate-group {
    margin-top: 3rem;
  }

  .certificate-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 12rem), 1fr));
    gap: 2.6rem 1.8rem;
  }

  .certificate-card {
    display: block;
    /* the whole card is the selection target: skip the link rainbow */
    background-image: none !important;

    /* wrap the global URL pop-up inside the card instead of clipping it at the screen edge */
    &[href]::after {
      min-width: 0;
      max-width: 100%;
      overflow-wrap: anywhere;
    }

    &:hover,
    &:focus {
      outline: none;

      & img {
        filter: none;
        outline: 2px solid var(--text-secondary);
      }

      & .certificate-card__name {
        background-color: var(--text-secondary);
        color: #000;
        text-shadow: none;
      }
    }
  }

  .certificate-card__thumb {
    display: block;
    margin-bottom: 0.7rem;

    & img {
      display: block;
      width: 100%;
      height: auto;
      outline-offset: 4px;
      filter: saturate(0.35) brightness(0.8);
      transition: filter 0.2s;
    }
  }

  .certificate-card__name {
    font-size: 0.9rem;
    line-height: 1.15;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .certificate-card__date {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.72rem;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  /* On hover/focus the certificate fills the screen behind the channel static. */
  .certificate-backdrop {
    opacity: 0.3;
    visibility: hidden;

    &,
    &::before {
      background-size: cover;
      background-position: center;
      position: fixed;
      z-index: -1;
      top: 0;
      left: 0;
      bottom: 0;
      right: 0;
    }

    &::before {
      content: '';
      background-image: url(/assets/images/effect-static.gif);
      transition: opacity 0.4s;

      html.webp & {
        background-image: url(/assets/images/effect-static.webp);
      }
    }

    .certificate-card:is(:hover, :focus) + & {
      visibility: visible;
      background-image: var(--image);

      &::before {
        opacity: 0.2;
      }
    }
  }
</style>
