---
import '../styles/markdown.css'
import { SITE, LOCALE_CODES, OG_LOCALES } from '../config/site'
import type { Locale } from '../config/site'
import {
  localeFromPath,
  normalizePath,
  alternatesForPath,
} from '../i18n/routes'
import {
  absoluteUrl,
  serializeJsonLd,
  jsonLdDocument,
  profilePageSchema,
} from '../utils/seo'

interface Props {
  frontmatter: {
    title: string
    description: string
  }
}

const { frontmatter } = Astro.props as Props

const path = normalizePath(Astro.url.pathname)
const locale: Locale = localeFromPath(path)
const otherLocale: Locale = locale === 'en' ? 'pt-br' : 'en'
const canonicalUrl = absoluteUrl(path)
const alternates = alternatesForPath(path)

const pageTitle = frontmatter.title
const pageDescription = frontmatter.description
const socialImage = absoluteUrl(SITE.ogImage[locale])
const socialImageAlt = `${SITE.displayName} — ${SITE.author}, ${SITE.jobTitle[locale]}`

const jsonLd = jsonLdDocument([profilePageSchema(locale, canonicalUrl)])

const langLinkLabel = locale === 'en' ? 'PT-BR' : 'EN'
const langLinkTarget = alternates[otherLocale]
const langLinkTitle =
  locale === 'en' ? 'Mudar para português' : 'Switch to English'
---

<html lang={LOCALE_CODES[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={SITE.author} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href={canonicalUrl} />

    {
      alternates.en && (
        <link
          rel="alternate"
          hreflang={LOCALE_CODES.en}
          href={absoluteUrl(alternates.en)}
        />
      )
    }
    {
      alternates['pt-br'] && (
        <link
          rel="alternate"
          hreflang={LOCALE_CODES['pt-br']}
          href={absoluteUrl(alternates['pt-br'])}
        />
      )
    }
    {
      alternates['pt-br'] && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={absoluteUrl(alternates['pt-br'])}
        />
      )
    }

    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content={SITE.displayName} />
    <meta property="og:locale" content={OG_LOCALES[locale]} />
    <meta property="og:locale:alternate" content={OG_LOCALES[otherLocale]} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <script
      is:inline
      type="application/ld+json"
      set:html={serializeJsonLd(jsonLd)}
    />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <div class="archive-strip">
      <span
        >OLWTELET · SIGNAL ARCHIVE / {
          locale === 'en' ? 'RESUME' : 'CURRÍCULO'
        }</span
      >
      {
        langLinkTarget && (
          <a
            href={langLinkTarget}
            hreflang={LOCALE_CODES[otherLocale]}
            lang={LOCALE_CODES[otherLocale]}
            title={langLinkTitle}
          >
            [{langLinkLabel}]
          </a>
        )
      }
    </div>
    <article class="markdown-body">
      <slot />
    </article>
  </body>
</html>

<style>
  .archive-strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    background-color: #000;
    color: #fff;
    font-family: 'Courier New', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 0.5em 1em;

    & a {
      color: #fff;
      text-decoration: none;

      &:hover,
      &:focus {
        background-color: #fff;
        color: #000;
      }
    }
  }

  @media print {
    .archive-strip {
      display: none;
    }
  }
</style>
