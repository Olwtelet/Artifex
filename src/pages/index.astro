---
import TVLayout from '../layouts/TVLayout.astro'
import HomeBio from '../components/HomeBio.astro'
import { SITE } from '../config/site'
import { routes } from '../i18n/routes'
import { useTranslations } from '../i18n/translations'
import { absoluteUrl, websiteSchema, profilePageSchema } from '../utils/seo'

const locale = 'pt-br'
const t = useTranslations(locale)

const title = 'Olwtelet — Isaac Rodrigues, Desenvolvedor Full-Stack'
const description =
  'Olwtelet é o portfólio de Isaac Rodrigues, desenvolvedor full-stack em Brasília que cria produtos web, automações e experimentos de IA aplicada e atua com cibersegurança.'

const schemas = [
  websiteSchema(locale),
  profilePageSchema(locale, absoluteUrl(routes.home[locale])),
]
---

<TVLayout title={title} description={description} schemas={schemas}>
  <HomeBio locale={locale}>
    <p class="big-text">
      Oi! Eu sou <span class="nowrap"
        ><button
          type="button"
          class="button-text bio__photo js-photo-toggle"
          aria-pressed="false"
          aria-label={t.bio.photoToggle}>Isaac Rodrigues</button
        >,</span
      > estudante de Ciência da Computação e desenvolvedor full-stack em
      <span class="nowrap"
        ><button class="button-text js-channel-trigger" data-channel="8"
          >Brasília, Brasil</button
        >.</span
      >
    </p>
    <p class="big-text">
      Crio produtos web, ferramentas de automação e experimentos de IA aplicada
      — de plataformas para clientes a pipelines de RAG e sistemas baseados em
      agentes. Hoje também atuo com cibersegurança na
      <a
        href="https://ordfall.vercel.app/"
        target="_blank"
        rel="noopener noreferrer">Ordfall</a
      >, tratando segurança como parte da arquitetura, não como a última etapa.
    </p>
    <p class="big-text">
      Gosto de levar uma ideia do primeiro rascunho até o produto publicado:
      pensar a arquitetura, construir a interface, conectar o back-end e cuidar
      dos detalhes que fazem a experiência ganhar vida — de preferência em um
      estado constante de
      <a
        href="https://pt.wikipedia.org/wiki/Fluxo_(psicologia)"
        target="_blank"
        rel="noopener noreferrer">Flow</a
      >.
    </p>
    <p class="big-text">
      Fora do código, passo um tempo pouco razoável montando playlists
      <span class="nowrap"
        ><span class="bio__soon">em breve neste canal</span>.</span
      >
      <span class="nowrap"
        ><button class="button-text js-channel-trigger" data-channel="1"
          >Sintonize</button
        >,</span
      > explore <a href={routes.projects[locale]}>meu trabalho</a> e meus
      <a href={routes.certificates[locale]}>certificados</a>, visite meu
      <a href={SITE.social.github} target="_blank" rel="noopener noreferrer"
        >GitHub</a
      > ou me mande um <a href={`mailto:${SITE.email}`}>e-mail</a>.
    </p>
  </HomeBio>
</TVLayout>
