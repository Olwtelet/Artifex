---
import TVLayout from '../layouts/TVLayout.astro'
import CertificateGallery from '../components/CertificateGallery.astro'
import { certificates } from '../data/certificates'
import { useTranslations } from '../i18n/translations'

const locale = 'pt-br'
const t = useTranslations(locale)
const count = String(certificates.length).padStart(2, '0')

const title = 'Certificados — Olwtelet (Isaac Rodrigues)'
const description =
  'Certificados de Olwtelet (Isaac Rodrigues) em cibersegurança, desenvolvimento com Claude e lógica de programação — Google, Anthropic e Udemy, cada um com link para a verificação oficial.'
---

<TVLayout title={title} description={description}>
  <article>
    <h1 class="index-title">
      CERTIFICADOS · {count}
      {t.listing.files}
    </h1>
    <CertificateGallery locale={locale} />
  </article>
</TVLayout>
