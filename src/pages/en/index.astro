---
import TVLayout from '../../layouts/TVLayout.astro'
import HomeBio from '../../components/HomeBio.astro'
import { SITE } from '../../config/site'
import { routes, projectRoute } from '../../i18n/routes'
import { useTranslations } from '../../i18n/translations'
import { absoluteUrl, websiteSchema, profilePageSchema } from '../../utils/seo'

const locale = 'en'
const t = useTranslations(locale)

const title = SITE.displayName
const socialTitle = `${SITE.displayName} — ${SITE.author}`
const description =
  'Olwtelet is the gaming handle of Isaac Rodrigues, a Computer Science student and full-stack developer in Brasília focused on applied AI and cybersecurity.'

const schemas = [
  websiteSchema(locale),
  profilePageSchema(locale, absoluteUrl(routes.home[locale])),
]
---

<TVLayout
  title={title}
  socialTitle={socialTitle}
  description={description}
  schemas={schemas}
>
  <HomeBio locale={locale}>
    <p class="big-text">
      I'm <span class="nowrap"
        ><button
          type="button"
          class="button-text bio__photo js-photo-toggle"
          aria-pressed="false"
          aria-label={t.bio.photoToggle}>Isaac Rodrigues</button
        >,</span
      > a programmer in
      <span class="nowrap"
        ><button class="button-text js-channel-trigger" data-channel="8"
          >Brasília, Brazil</button
        >.</span
      > Olwtelet is my gaming handle and the name I put on my work. It's my username
      on GitHub and LinkedIn and the name of Olwtelet Productions, an indie game studio
      I direct that has no game out yet.
    </p>
    <p class="big-text">
      I'm currently the director of
      <a
        href="https://ordfall.vercel.app/"
        target="_blank"
        rel="noopener noreferrer">Ordfall</a
      >, a Brazilian software engineering and cybersecurity company for critical
      systems. There, I built the website and handle security: I analyze
      vulnerabilities and review code, dependencies and configurations. A demo
      proves that software works once. What I care about is whether it keeps
      working with bad data, unexpected use and someone trying to break in.
    </p>
    <p class="big-text">
      I study Computer Science and have been taking MIT OpenCourseWare courses
      since 2024. I work as a full-stack developer (TypeScript, Python, React,
      Next.js, Node.js, FastAPI), focused on applied AI and cybersecurity.
    </p>
    <p class="big-text">
      For
      <a
        href="https://www.integratek.com.br/"
        target="_blank"
        rel="noopener noreferrer">Integratek</a
      >, an IT infrastructure company I've worked with since June 2026, I
      developed the website, blog and quote forms. I also built the websites for
      the law firm
      <a href={projectRoute('rocha-e-sa')[locale]}>Rocha &amp; Sá</a>, the
      tennis training center
      <a href={projectRoute('thalit-academy')[locale]}>CT Thalita Rodrigues</a>
      and the nonprofit
      <a href={projectRoute('instituto-politecnico-do-brasil')[locale]}
        >Instituto Politécnico do Brasil</a
      >.
    </p>
    <p class="big-text">
      I created and maintain
      <a href={projectRoute('argus')[locale]}>Argus</a>, which brings dozens of
      public feeds (aircraft, vessels, satellites, earthquakes) onto one live
      map. With AI, I use only what I can test, observe and constrain: in
      <a href={projectRoute('agentforge')[locale]}>AgentForge</a>, I implement
      the same agent in ten frameworks and measure latency, token usage and
      failure rate. Both are open source.
    </p>
    <p class="big-text">
      My gaming profile, under the same handle, is on
      <a
        href="https://konect.gg/olwtelet"
        target="_blank"
        rel="noopener noreferrer">konect</a
      >
      <span class="nowrap"
        ><span class="bio__soon">coming soon to this channel</span>.</span
      >
      <span class="nowrap"
        ><button class="button-text js-channel-trigger" data-channel="1"
          >Tune in</button
        >:</span
      > browse the <a href={routes.projects[locale]}>projects</a> and
      <a href={routes.certificates[locale]}>certificates</a>. Code is on
      <a href={SITE.social.github} target="_blank" rel="noopener noreferrer"
        >GitHub</a
      >; reach me by <a href={`mailto:${SITE.email}`}>e-mail</a>.
    </p>
  </HomeBio>
</TVLayout>
