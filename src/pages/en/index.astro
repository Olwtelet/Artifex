---
import TVLayout from '../../layouts/TVLayout.astro'
import HomeBio from '../../components/HomeBio.astro'
import { SITE } from '../../config/site'
import { routes } from '../../i18n/routes'
import { useTranslations } from '../../i18n/translations'
import { absoluteUrl, websiteSchema, profilePageSchema } from '../../utils/seo'

const locale = 'en'
const t = useTranslations(locale)

const title = 'Olwtelet — Isaac Rodrigues, Full-Stack Developer'
const description =
  'Olwtelet is the portfolio of Isaac Rodrigues, a full-stack developer in Brasília building web products, automation tools, and applied AI experiments, and working in cybersecurity.'

const schemas = [
  websiteSchema(locale),
  profilePageSchema(locale, absoluteUrl(routes.home[locale])),
]
---

<TVLayout title={title} description={description} schemas={schemas}>
  <HomeBio locale={locale}>
    <p class="big-text">
      Hi! I'm <button
        type="button"
        class="button-text bio__photo js-photo-toggle"
        aria-pressed="false"
        aria-label={t.bio.photoToggle}>Isaac Rodrigues</button
      >, a Computer Science student and full-stack developer based in
      <button class="button-text js-channel-trigger" data-channel="8"
        >Brasília, Brazil</button
      >.
    </p>
    <p class="big-text">
      I build web products, automation tools, and applied AI experiments — from
      client-facing platforms to RAG pipelines and agent-based systems. These
      days I also work on cybersecurity at
      <a
        href="https://ordfall.vercel.app/"
        target="_blank"
        rel="noopener noreferrer">Ordfall</a
      >, treating security as part of the architecture rather than the last
      step.
    </p>
    <p class="big-text">
      I enjoy taking ideas from the first sketch to a deployed product: shaping
      the architecture, building the interface, connecting the back end, and
      polishing the details that make the experience feel alive — ideally in a
      constant state of
      <a
        href="https://en.wikipedia.org/wiki/Flow_(psychology)"
        target="_blank"
        rel="noopener noreferrer">Flow</a
      >.
    </p>
    <p class="big-text">
      Outside of code, I spend an unreasonable amount of time curating
      <a href={routes.playlists[locale]}>playlists</a>.
      <button class="button-text js-channel-trigger" data-channel="1"
        >Tune in</button
      >, explore <a href={routes.projects[locale]}>my work</a> and
      <a href={routes.certificates[locale]}>certificates</a>, visit my
      <a href={SITE.social.github} target="_blank" rel="noopener noreferrer"
        >GitHub</a
      >, or send me an <a href={`mailto:${SITE.email}`}>e-mail</a>.
    </p>
  </HomeBio>
</TVLayout>
