---
import TVLayout from '../../layouts/TVLayout.astro'
import HomeBio from '../../components/HomeBio.astro'
import { SITE } from '../../config/site'
import { routes, projectRoute } from '../../i18n/routes'
import { useTranslations } from '../../i18n/translations'
import { absoluteUrl, websiteSchema, profilePageSchema } from '../../utils/seo'

const locale = 'en'
const t = useTranslations(locale)

const title = SITE.displayName
const socialTitle = `${SITE.displayName} — ${SITE.author}`
const description =
  'Olwtelet is the pseudonym of Isaac Rodrigues, a software developer in Brasília, Brazil. Notes and an archive of what he builds.'

const schemas = [
  websiteSchema(locale),
  profilePageSchema(locale, absoluteUrl(routes.home[locale])),
]
---

<TVLayout
  title={title}
  socialTitle={socialTitle}
  description={description}
  schemas={schemas}
>
  <HomeBio locale={locale}>
    <p class="big-text">
      My name is <span class="nowrap"
        ><button
          type="button"
          class="button-text bio__photo js-photo-toggle"
          aria-pressed="false"
          aria-label={t.bio.photoToggle}>Isaac Rodrigues</button
        >.</span
      > I'm a software developer in
      <span class="nowrap"
        ><button class="button-text js-channel-trigger" data-channel="8"
          >Brasília, Brazil</button
        >.</span
      > Olwtelet is the pseudonym I've used since my first projects on the internet,
      and today it brings together my work as a programmer, independent researcher
      and creator.
    </p>
    <p class="big-text">
      At Olwtelet Productions, I develop my own software, games and web
      applications. I'm currently working on Veil, a chess-inspired strategy
      game for the browser, and Diseens, an academic passport platform. I'm also
      responsible for
      <a
        href="https://filmeshdonlinegratis.vercel.app/"
        target="_blank"
        rel="noopener noreferrer">Filmes HD Online Grátis</a
      >, an independent film curation project with screenings held live on
      Discord.
    </p>
    <p class="big-text">
      I study Computer Science and have followed MIT OpenCourseWare materials
      since 2024. In development, I work mainly with TypeScript, Python, React,
      Next.js, Node.js and FastAPI. I'm particularly interested in artificial
      intelligence, cybersecurity and systems architecture.
    </p>
    <p class="big-text">
      I also build solutions for clients. Since June 2026, I've worked with
      <a href={projectRoute('integratek')[locale]}>Integratek</a>, where I built
      the company website, the blog and the quote forms. Other work includes the
      websites for
      <a href={projectRoute('rocha-e-sa')[locale]}>Rocha &amp; Sá</a>,
      <a href={projectRoute('thalit-academy')[locale]}>CT Thalita Rodrigues</a>
      and
      <a href={projectRoute('instituto-politecnico-do-brasil')[locale]}
        >Instituto Politécnico do Brasil</a
      >.
    </p>
    <p class="big-text">
      At Ordfall, I take part in cybersecurity projects, analyzing
      vulnerabilities and reviewing code, dependencies and configurations.
    </p>
    <p class="big-text">
      My independent projects include
      <a href={projectRoute('argus')[locale]}>Argus</a>, a platform that brings
      public data on aircraft, vessels, satellites and earthquakes together on
      an interactive map, and
      <a href={projectRoute('agentforge')[locale]}>AgentForge</a>, an
      environment for comparing ten AI agent frameworks. The second uses
      equivalent implementations to measure latency, token usage and failure
      rate. Both are open source.
    </p>
    <p class="big-text">
      Outside programming, I keep my gamer profile under the pseudonym Olwtelet
      on
      <a
        href="https://konect.gg/olwtelet"
        target="_blank"
        rel="noopener noreferrer">Konect</a
      >
      <span class="nowrap"
        ><span class="bio__soon">coming soon to this channel</span>.</span
      >
    </p>
    <p class="big-text">
      <span class="nowrap"
        ><button class="button-text js-channel-trigger" data-channel="1"
          >Tune in</button
        >:</span
      > this site works as an archive of my work:
      <a href={routes.projects[locale]}>projects</a>,
      <a href={routes.openSource[locale]}>experiments</a>,
      <a href={routes.certificates[locale]}>certificates</a> and other initiatives
      I develop over time.
    </p>
  </HomeBio>
</TVLayout>
