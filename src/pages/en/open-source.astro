---
import TVLayout from '../../layouts/TVLayout.astro'
import ProjectList from '../../components/ProjectList.astro'
import { getProjectsByCollection } from '../../data/projects'
import { useTranslations } from '../../i18n/translations'

const locale = 'en'
const t = useTranslations(locale)
const projects = getProjectsByCollection('open-source')
const count = String(projects.length).padStart(2, '0')

const title = 'Open Source — Olwtelet (Isaac Rodrigues)'
const description =
  'Open-source projects by Olwtelet (Isaac Rodrigues) — automation pipelines, multi-agent AI experiments, and a public study vault, each with its own signal file.'
---

<TVLayout title={title} description={description}>
  <article>
    <h1 class="index-title">
      {t.listing.channelIndex} — OPEN SOURCE · {count}
      {t.listing.files}
    </h1>
    <ProjectList projects={projects} locale={locale} />
  </article>
</TVLayout>
