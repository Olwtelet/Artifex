---
import TVLayout from '../../layouts/TVLayout.astro'
import ProjectList from '../../components/ProjectList.astro'
import { getProjectsByCollection } from '../../data/projects'
import { useTranslations } from '../../i18n/translations'

const locale = 'en'
const t = useTranslations(locale)
const projects = getProjectsByCollection('websites')
const count = String(projects.length).padStart(2, '0')

const title = 'Websites'
const description =
  'Websites built by Olwtelet (Isaac Rodrigues) — client work and institutional pages built with Astro, Next.js, and TypeScript, each with its own signal file.'
---

<TVLayout title={title} description={description}>
  <article>
    <h1 class="index-title">
      {t.listing.channelIndex} — WEBSITES · {count}
      {t.listing.files}
    </h1>
    <ProjectList projects={projects} locale={locale} />
  </article>
</TVLayout>
