---
import TVLayout from '../../../layouts/TVLayout.astro'
import ProjectDossier from '../../../components/ProjectDossier.astro'
import { allProjects, localizeProject } from '../../../data/projects'
import type { Project } from '../../../data/projects'
import { projectSchema } from '../../../utils/seo'

export function getStaticPaths() {
  return allProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }))
}

interface Props {
  project: Project
}

const { project } = Astro.props
const locale = 'pt-br'
const lp = localizeProject(project, locale)

const title = `${project.name} — Projeto de Olwtelet (Isaac Rodrigues)`
const description = lp.overview ?? lp.summary
const socialImage = `/assets/og/project-${project.slug}-${locale}.png`
const socialImageAlt = `${project.name} — arquivo de sinal do portfólio de Olwtelet (Isaac Rodrigues)`
---

<TVLayout
  title={title}
  description={description}
  socialImage={socialImage}
  socialImageAlt={socialImageAlt}
  schemas={[projectSchema(lp, locale)]}
>
  <ProjectDossier project={project} locale={locale} />
</TVLayout>
