---
import TVLayout from '../../layouts/TVLayout.astro'
import ProjectList from '../../components/ProjectList.astro'
import { getProjectsByCollection } from '../../data/projects'
import { useTranslations } from '../../i18n/translations'

const locale = 'pt-br'
const t = useTranslations(locale)
const projects = getProjectsByCollection('open-source')
const count = String(projects.length).padStart(2, '0')

const title = 'Código Aberto — Olwtelet (Isaac Rodrigues)'
const description =
  'Projetos de código aberto de Olwtelet (Isaac Rodrigues) — pipelines de automação, experimentos de IA multiagente e um cofre público de estudos, cada um com seu arquivo de sinal.'
---

<TVLayout title={title} description={description}>
  <article>
    <h1 class="index-title">
      {t.listing.channelIndex} — CÓDIGO ABERTO · {count}
      {t.listing.files}
    </h1>
    <ProjectList projects={projects} locale={locale} />
  </article>
</TVLayout>
